RewriteEngine On

# Remove .html extension from URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# Redirect index.html to /home
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^index\.html$ /home [R=301,L]

# Rewrite /home to index.html internally
RewriteRule ^home$ index.html [L]

# Redirect detail_projects.html to /myprojects
RewriteCond %{THE_REQUEST} /detail_projects\.html [NC]
RewriteRule ^detail_projects\.html$ /myprojects [R=301,L]

# Rewrite /myprojects to detail_projects.html internally
RewriteRule ^myprojects$ detail_projects.html [L]

# Force HTTPS (if you have SSL)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Force www (optional)
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
